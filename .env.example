# Copie para .env.local e preencha. Nunca faca commit do .env.local.

# --- Firebase: configuracao publica do app web -------------------------------
# Vai para o bundle do cliente por design; nao sao segredos.
# Console do Firebase -> Configuracoes do projeto -> Seus aplicativos -> Web.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin: somente no servidor -------------------------------------
# Console do Firebase -> Configuracoes do projeto -> Contas de servico.
# Sem estas, entrar em campanha por codigo de convite e enviar imagens falham.
# A chave privada vai entre aspas, com as quebras de linha escapadas como \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Google Drive: armazenamento das imagens do chat -------------------------
# ID da pasta de destino. Obrigatorio para o upload de imagens funcionar.
GOOGLE_DRIVE_CHAT_FOLDER_ID=
# Opcional: usa uma conta OAuth propria em vez da conta de servico do Firebase.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# --- Discord Activity: opcional ----------------------------------------------
# Necessario apenas para rodar dentro do Discord. A versao web funciona sem.
NEXT_PUBLIC_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Opcional ----------------------------------------------------------------
# URL canonica para os previews de link. Sem isto o app usa a URL de producao
# da Vercel e, por ultimo, https://rpgcord.vercel.app
NEXT_PUBLIC_SITE_URL=
