rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function campaign(campaignId) {
      return get(/databases/$(database)/documents/campaigns/$(campaignId));
    }
    function campaignAfter(campaignId) {
      return getAfter(/databases/$(database)/documents/campaigns/$(campaignId));
    }
    function isMember(campaignId) {
      return signedIn() && request.auth.uid in campaign(campaignId).data.memberIds;
    }
    function isMemberAfter(campaignId) {
      return signedIn() && request.auth.uid in campaignAfter(campaignId).data.memberIds;
    }
    function isOwner(campaignId) {
      return signedIn() && campaign(campaignId).data.ownerId == request.auth.uid;
    }
    function isOwnerAfter(campaignId) {
      return signedIn() && campaignAfter(campaignId).data.ownerId == request.auth.uid;
    }
    function controls(data) {
      return data.ownerId == request.auth.uid
        || (data.keys().hasAll(['controllerIds'])
          && data.controllerIds is list
          && request.auth.uid in data.controllerIds);
    }
    function keepsControllers() {
      return (resource.data.keys().hasAll(['controllerIds'])
          && request.resource.data.keys().hasAll(['controllerIds'])
          && request.resource.data.controllerIds == resource.data.controllerIds)
        || (!resource.data.keys().hasAll(['controllerIds'])
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.controllerIds is list
          && request.resource.data.controllerIds.size() == 1
          && request.resource.data.controllerIds[0] == request.auth.uid);
    }
    function onlyRemovesOwnController() {
      return request.resource.data.controllerIds is list
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['controllerIds'])
        && ((resource.data.controllerIds is list
            && resource.data.controllerIds.toSet().difference(request.resource.data.controllerIds.toSet()).hasOnly([request.auth.uid])
            && request.resource.data.controllerIds.toSet().difference(resource.data.controllerIds.toSet()).size() == 0)
          || (!resource.data.keys().hasAll(['controllerIds'])
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.controllerIds.size() == 0));
    }
    function ownerOnlyChangesOwnControl() {
      return resource.data.ownerId == request.auth.uid
        && request.resource.data.controllerIds is list
        && ((resource.data.controllerIds is list
            && resource.data.controllerIds.toSet().difference(request.resource.data.controllerIds.toSet()).hasOnly([request.auth.uid])
            && request.resource.data.controllerIds.toSet().difference(resource.data.controllerIds.toSet()).hasOnly([request.auth.uid]))
          || (!resource.data.keys().hasAll(['controllerIds'])
            && request.resource.data.controllerIds.toSet().hasOnly([request.auth.uid])));
    }

    match /campaigns/{campaignId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid;
      allow update: if isOwner(campaignId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.inviteCode == resource.data.inviteCode;
      // Um jogador pode sair sozinho: so pode retirar o proprio id de memberIds,
      // sem acrescentar ninguem e sem tocar em nenhum outro campo.
      allow update: if signedIn()
        && request.auth.uid != resource.data.ownerId
        && request.auth.uid in resource.data.memberIds
        && !(request.auth.uid in request.resource.data.memberIds)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
        && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0;
      allow delete: if isOwner(campaignId);

      match /members/{memberId} {
        allow read: if isMember(campaignId);
        allow create: if isMemberAfter(campaignId)
          && (memberId == request.auth.uid || isOwnerAfter(campaignId));
        allow update: if isMember(campaignId)
          && (memberId == request.auth.uid || isOwner(campaignId));
        // O mestre remove quem quiser; cada jogador pode remover a si mesmo.
        allow delete: if signedIn()
          && (memberId == request.auth.uid || isOwner(campaignId));
      }

      match /characters/{characterId} {
        allow read: if isMember(campaignId);
        allow create: if isMember(campaignId)
          && request.resource.data.ownerId == characterId
          && request.resource.data.controllerIds is list
          && (request.auth.uid in request.resource.data.controllerIds || isOwner(campaignId))
          && (characterId == request.auth.uid || isOwner(campaignId));
        allow update: if isMember(campaignId)
          && request.resource.data.ownerId == resource.data.ownerId
          && (isOwner(campaignId)
            || (controls(resource.data) && keepsControllers())
            || ownerOnlyChangesOwnControl()
            || onlyRemovesOwnController());
        allow delete: if isMember(campaignId)
          && (resource.data.ownerId == request.auth.uid || isOwner(campaignId));
      }

      match /dicerolls/{rollId} {
        allow read: if isMember(campaignId);
        allow create: if isMember(campaignId)
          && request.resource.data.userId == request.auth.uid;
        allow update: if false;
        allow delete: if isOwner(campaignId);
      }

      match /chatMessages/{messageId} {
        allow read: if isMember(campaignId);
        allow create: if isMember(campaignId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000;
        allow update: if false;
        allow delete: if isMember(campaignId)
          && (resource.data.userId == request.auth.uid || isOwner(campaignId));
      }
      match /whispers/{messageId} {
        allow read: if isMember(campaignId)
          && request.auth.uid in resource.data.participantIds;
        allow create: if isMember(campaignId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.recipientId in campaign(campaignId).data.memberIds
          && request.resource.data.participantIds.size() == 2
          && campaign(campaignId).data.ownerId in request.resource.data.participantIds
          && request.auth.uid in request.resource.data.participantIds
          && request.resource.data.recipientId in request.resource.data.participantIds
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000;
        allow update: if false;
        allow delete: if isMember(campaignId)
          && (resource.data.userId == request.auth.uid || isOwner(campaignId));
      }

      match /journal/{entryId} {
        allow read: if isMember(campaignId);
        allow create, update: if isOwner(campaignId);
        allow delete: if isOwner(campaignId);
      }
      match /notes/{noteId} {
        allow get: if isMember(campaignId)
          && (noteId == request.auth.uid
            || (isOwner(campaignId) && resource.data.shareWithGM == true)
            || request.auth.uid in resource.data.sharedWithPlayerIds);
        allow list: if false;
        allow create, update: if isMember(campaignId)
          && noteId == request.auth.uid
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 20000;
        allow delete: if signedIn() && (noteId == request.auth.uid || isOwner(campaignId));
      }

      match /music/{musicId} {
        allow read: if isMember(campaignId);
        allow create, update: if isOwner(campaignId);
        allow delete: if isOwner(campaignId);
      }

      match /initiative/{initiativeId} {
        allow read: if isMember(campaignId);
        allow create, update, delete: if isOwner(campaignId);
      }

      match /tokens/{tokenId} {
        allow read: if isMember(campaignId);
        allow create: if isMember(campaignId)
          && (isOwner(campaignId)
            || (request.resource.data.controllerIds is list
              && request.auth.uid in request.resource.data.controllerIds));
        allow update: if isMember(campaignId)
          && request.resource.data.ownerId == resource.data.ownerId
          && (isOwner(campaignId)
            || (controls(resource.data) && keepsControllers())
            || ownerOnlyChangesOwnControl()
            || onlyRemovesOwnController());
        allow delete: if isMember(campaignId)
          && (isOwner(campaignId)
            || resource.data.ownerId == request.auth.uid
            || (resource.data.controllerIds is list
              && resource.data.controllerIds.size() == 1
              && resource.data.controllerIds[0] == request.auth.uid));
      }

      match /scenes/{sceneId} {
        allow read: if isMember(campaignId);
        allow write: if isOwner(campaignId);
      }
    }

    match /campaignInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && isOwnerAfter(request.resource.data.campaignId);
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
